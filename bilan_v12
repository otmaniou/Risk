   "source": "# ════════════════════════════════════════════════════════════\n# CELLULE 16 — TRANSPOSITION SÛRE V12\n# Source: le .controle.json (relu depuis disque), JAMAIS le json brut.\n# Regles: valeur_certaine=False -> ecartee (non ecrite) + tracee.\n#         cellule a formule -> jamais ecrite, valeur part en comparaison.\n#         ligne/colonne/tableau hors modele -> ignore + trace.\n# ════════════════════════════════════════════════════════════\nimport shutil, subprocess, openpyxl, sys\nfrom openpyxl.comments import Comment\nfrom openpyxl.styles import Alignment, Border, Font, PatternFill, Protection, Side\n\nMODELE_CANDIDATS = [\n Path('/mnt/data/Liasse_fiscale_G2_BNP_Paribas_El_Djazair_5.xlsx'),\n Path('/mnt/data/Liasse_fiscale_G2_BNP_Paribas_El_Djazair.xlsx'),\n Path('/mnt/Risk/Liasse_fiscale_G2_BNP_Paribas_El_Djazair_5.xlsx'),\n Path('/mnt/Risk/Liasse_fiscale_G2_BNP_Paribas_El_Djazair.xlsx')]\nMODELE_XLSX = next((p for p in MODELE_CANDIDATS if p.exists()), MODELE_CANDIDATS[0])\n\nRECALC_TOOL = next((p for p in (Path.cwd()/'recalc_liasse.py', Path('/mnt/code/recalc_liasse.py'), Path('/mnt/data/recalc_liasse.py')) if p.exists()), None)\nRECALC_DISPONIBLE = bool(RECALC_TOOL) and bool(shutil.which('soffice'))\n\n_ROUGE = Border([Side(style='medium', color='FF0000')]*4)\n_ROUGE_FOND = PatternFill('solid', start_color='FFC7CE')\n_ROUGE_TEXTE = Font(bold=True, color='9C0006')\n_LIBRE = Protection(locked=False)\n_VERROU = Protection(locked=True)\n\ndef _est_formule(c):\n return isinstance(c.value, str) and c.value.startswith('=')\n\ndef _index_certitudes(doc):\n idx = {}\n for page in doc.get('pages', []):\n  cd = page.get('controles_donnees') or {}\n  for tab, rows in cd.items():\n   for cle, cols in (rows or {}).items():\n    for col, info in (cols or {}).items():\n     idx[(tab, cle, col)] = info\n return idx\n\ndef _postes_a_ecrire(doc):\n cert = _index_certitudes(doc)\n fixes, dynamiques, ecartes, ignores = [], {}, [], []\n for _page, tab, bloc in iter_blocs(doc):\n  for cle, vals, libelle in lire_bloc(bloc):\n   vals = vals or {}\n   if tab in FIXED_TABLES:\n    if cle not in MAP_LIGNES.get(tab, {}):\n     if any(v is not None for v in vals.values()): ignores.append((tab, cle, 'ligne_hors_modele'))\n     continue\n    for col, v in vals.items():\n     if v is None: continue\n     if col not in MAP_COLONNES.get(tab, {}): ignores.append((tab, cle, col)); continue\n     info = cert.get((tab, cle, col))\n     if info and info.get('valeur_certaine') is False:\n      ecartes.append((tab, cle, col, v, info.get('ecart'))); continue\n     fixes.append((tab, cle, col, v))\n   elif tab in DYNAMIC_TABLES:\n    if not (any(v is not None for v in vals.values()) or libelle): continue\n    row_vals = {}\n    for col, v in vals.items():\n     if v is None: continue\n     if col not in MAP_COLONNES.get(tab, {}): continue\n     info = cert.get((tab, cle, col))\n     if info and info.get('valeur_certaine') is False:\n      ecartes.append((tab, cle, col, v, info.get('ecart'))); continue\n     row_vals[col] = v\n    if row_vals or libelle: dynamiques.setdefault(tab, []).append({'libelle': libelle, 'valeurs': row_vals})\n   else:\n    if any(v is not None for v in vals.values()): ignores.append((tab, cle, 'tableau_hors_modele'))\n return fixes, dynamiques, ecartes, ignores\n\ndef _ecrire_valeurs(wb, doc):\n fixes, dynamiques, ecartes, ignores = _postes_a_ecrire(doc)\n ecrits, totaux, par_tableau = 0, [], {}\n ident = doc.get('identite') or {}\n ws1 = wb[MAP_FEUILLES['ACTIF']]\n if ident.get('nif_15'): ws1[MAP_ENTETE['nif']] = ident['nif_15']\n if ident.get('entreprise'): ws1[MAP_ENTETE['entreprise']] = ident['entreprise']\n if ident.get('exercice_clos'): ws1[MAP_ENTETE['exercice']] = ident['exercice_clos']\n for feuille, coord, quel in MAP_MILLESIMES:\n  annee = ident.get('annee_n') if quel == 'N' else ident.get('annee_n1')\n  if annee: wb[feuille][coord] = ('N : ' + str(annee) if quel == 'N' else 'N-1 : ' + str(annee))\n for tab, rc, col, val in fixes:\n  ligne, _ = MAP_LIGNES[tab][rc]\n  colonne = MAP_COLONNES[tab][col]\n  cible = wb[MAP_FEUILLES[tab]][colonne + str(ligne)]\n  if _est_formule(cible):\n   if isinstance(val, (int, float)) and not isinstance(val, bool): totaux.append((MAP_FEUILLES[tab], colonne + str(ligne), tab, rc, col, float(val)))\n   continue\n  cible.value = val; ecrits += 1\n  par_tableau[tab] = par_tableau.get(tab, 0) + 1\n for tab, lignes in dynamiques.items():\n  debut, fin, col_lib = MAP_DYNAMIQUES[tab]\n  ws = wb[MAP_FEUILLES[tab]]; r = debut\n  for item in lignes:\n   if r > fin: ignores.append((tab, 'ligne ' + str(r), 'plage_saturee')); break\n   if col_lib and item.get('libelle'): ws[col_lib + str(r)] = item['libelle']\n   for col, v in (item.get('valeurs') or {}).items():\n    cellule = ws[MAP_COLONNES[tab][col] + str(r)]\n    if _est_formule(cellule):\n     if isinstance(v, (int, float)) and not isinstance(v, bool): totaux.append((MAP_FEUILLES[tab], MAP_COLONNES[tab][col] + str(r), tab, 'ligne ' + str(r), col, float(v)))\n    else: cellule.value = v; ecrits += 1; par_tableau[tab] = par_tableau.get(tab, 0) + 1\n   r += 1\n return ecrits, totaux, ecartes, ignores, par_tableau\n\ndef _comparer_et_annoter(chemin_calcule, wb, totaux, doc, tolerance=TOLERANCE_DA):\n calc = None\n if chemin_calcule is not None:\n  try: calc = openpyxl.load_workbook(chemin_calcule, data_only=True)\n  except Exception: calc = None\n replis = {}\n if calc is None and doc is not None:\n  for f in (doc.get('controles') or {}).get('formules', []): replis[(f['tableau'], f['poste'], f['colonne'])] = f['valeur_recalculee']\n anomalies = []\n for feuille, coord, tab, rc, col, extraite in totaux:\n  if calc is not None:\n   recalc = calc[feuille][coord].value\n   if recalc is None: continue\n   recalc = float(recalc)\n  else:\n   if (tab, rc, col) not in replis: continue\n   recalc = float(replis[(tab, rc, col)])\n  ecart = extraite - recalc\n  if abs(ecart) <= tolerance: continue\n  c = wb[feuille][coord]\n  c.border, c.fill, c.font = _ROUGE, _ROUGE_FOND, _ROUGE_TEXTE\n  c.comment = Comment('INCOHERENCE DETECTEE\\nValeur lue: ' + format(extraite, ',.2f') + '\\nValeur recalculee: ' + format(recalc, ',.2f') + '\\nEcart: ' + format(ecart, ',.2f'), 'Controle extraction')\n  anomalies.append({'tableau': tab, 'poste': rc, 'colonne': col, 'feuille': feuille, 'cellule': coord, 'valeur_extraite': extraite, 'valeur_recalculee': recalc, 'ecart': round(ecart, 2)})\n return anomalies\n\ndef _feuille_archive(wb, doc, anomalies, ignores, ecartes):\n if '0. Données extraites' in wb.sheetnames: del wb['0. Données extraites']\n ws = wb.create_sheet('0. Données extraites', 0)\n ident = doc.get('identite') or {}\n synth = (doc.get('controles') or {}).get('synthese', {})\n ws['A1'] = 'DONNEES EXTRAITES DE LA LIASSE — PIECE DE REFERENCE'\n ws['A1'].font = Font(bold=True, size=14)\n infos = [('Fichier source', doc.get('document', {}).get('fichier_source')), ('Entreprise', ident.get('entreprise')), ('NIF (15)', ident.get('nif_15')), ('Exercice clos', ident.get('exercice_clos')), ('Dossier homogene', 'OUI' if ident.get('dossier_homogene') else 'NON'), ('Formules en ecart', synth.get('formules_en_ecart')), ('Controles en ecart', synth.get('controles_en_ecart')), ('Valeurs incertaines ecartees', len(ecartes))]\n r = 3\n for lib, val in infos:\n  ws.cell(r, 1, lib).font = Font(bold=True); ws.cell(r, 2, val); r += 1\n r += 1; ws.cell(r, 1, 'VALEURS INCERTAINES NON ECRITES').font = Font(bold=True, size=12); r += 1\n for tab, cle, col, v, ec in ecartes:\n  ws.cell(r, 1, tab); ws.cell(r, 2, cle); ws.cell(r, 3, col); ws.cell(r, 4, v); ws.cell(r, 5, 'ecart controle: ' + str(ec)); r += 1\n if not ecartes: ws.cell(r, 2, 'Aucune.'); r += 1\n r += 1; ws.cell(r, 1, 'ECARTS DECLARE / RECALCULE').font = Font(bold=True, size=12); r += 1\n for a in anomalies:\n  ws.cell(r, 1, a['tableau']); ws.cell(r, 2, a['poste']); ws.cell(r, 3, a['feuille'] + '!' + a['cellule']); ws.cell(r, 4, a['valeur_extraite']); 