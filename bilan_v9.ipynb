    'elements_extraordinaires_charges': 49,
    'resultat_extraordinaire': 50,
    'impots_exigibles_resultats': 51,
    'impots_differes_resultats': 52,
    'resultat_net_exercice': 53,
}

# Postes TCR qui vont en CREDIT (produits)
TCR_CREDIT = {
    'ventes_marchandises', 'produits_fabriques', 'prestations_services',
    'ventes_travaux', 'produits_annexes', 'chiffre_affaires_net',
    'production_stockee_destockee', 'production_immobilisee',
    'subvention_exploitation', 'production_exercice',
    'rabais_remises_obtenus_achats', 'rabais_remises_obtenus_services',
    'valeur_ajoutee_exploitation', 'excedent_brut_exploitation',
    'autres_produits_operationnels', 'reprises_pertes_valeur_provisions',
    'produits_financiers', 'elements_extraordinaires_produits',
}

# Postes TCR qui vont en DEBIT (charges)
TCR_DEBIT = {
    'rabais_remises_ristournes_accordes', 'achats_marchandises_vendues',
    'matieres_premieres', 'autres_approvisionnements', 'variation_stocks',
    'achats_etudes_prestations', 'autres_consommations',
    'sous_traitance_generale', 'locations', 'entretien_reparations',
    'primes_assurances', 'personnel_exterieur', 'remuneration_intermediaires',
    'publicite', 'deplacements_missions', 'autres_services',
    'consommations_exercice', 'charges_personnel', 'impots_taxes_assimiles',
    'autres_charges_operationnelles', 'dotations_amortissements',
    'provisions', 'pertes_valeur', 'charges_financieres',
    'elements_extraordinaires_charges', 'impots_exigibles_resultats',
    'impots_differes_resultats',
}


def to_kdzd(v):
    """Convertit dinars en KDZD."""
    if v is None:
        return None
    return round(v / 1000.0, 2)


def generer_forfait(json_path: Path) -> dict:
    """
    Génère un fichier FORFAIT à partir du JSON extrait.
    Marque en rouge les cellules incohérentes.
    Retourne un rapport de contrôle.
    """
    # Lire le JSON
    with open(json_path, 'r', encoding='utf-8') as f:
        data = json.load(f)

    actif  = data.get('ACTIF', {})
    passif = data.get('PASSIF', {})
    tcr    = data.get('TCR', {})

    entreprise = data.get('entreprise', 'ENTREPRISE')
    exercice = data.get('exercice', 'XXXX')
    annee = exercice.split('/')[-1] if exercice else 'XXXX'

    # Nom du fichier de sortie
    nom_fichier = f"FORFAIT Cas 1_{entreprise}_{annee}.xlsx"
    chemin_sortie = FORFAIT_OUTPUT_DIR / nom_fichier

    # Copier le template
    shutil.copy2(TEMPLATE_FORFAIT, chemin_sortie)

    # Ouvrir le fichier
    wb = load_workbook(chemin_sortie)

    # ─── EFFECTUER LES CONTRÔLES ───
    ctrl_actif  = controle_actif(actif)
    ctrl_passif = controle_passif(passif)
    ctrl_tcr    = controle_tcr(tcr)
    ctrl_croise = controle_croise(actif, passif, tcr)

    tous_controles = {}
    tous_controles.update(ctrl_actif)
    tous_controles.update(ctrl_passif)
    tous_controles.update(ctrl_tcr)
    tous_controles.update(ctrl_croise)

    # Identifier les incohérences
    incoherences = {k: v for k, v in tous_controles.items() if not v['ok']}

    # ─── REMPLIR LA FEUILLE ACTIF ───
    if 'Saisie actif' in wb.sheetnames:
        ws = wb['Saisie actif']

        # Remplir les métadonnées
        ws.cell(row=2, column=5, value='Fiscal')  # Nature bilan
        if exercice:
            ws.cell(row=3, column=5, value=exercice)  # Date arrêté N

        # Remplir les postes
        for poste, row in FORFAIT_ACTIF_ROWS.items():
            brut  = actif.get(f'{poste}_brut')
            amort = actif.get(f'{poste}_amort')
            net   = actif.get(f'{poste}_n')
            net_n1 = actif.get(f'{poste}_n1')

            # N : Brut, Amort, Net (colonnes 5, 6, 7)
            if brut is not None:
                ws.cell(row=row, column=5, value=to_kdzd(brut))
            if amort is not None:
                ws.cell(row=row, column=6, value=to_kdzd(amort))
            if net is not None:
                ws.cell(row=row, column=7, value=to_kdzd(net))

            # N-1 : Net uniquement (colonne 10)
            if net_n1 is not None:
                ws.cell(row=row, column=10, value=to_kdzd(net_n1))

            # Vérifier si ce poste a une incohérence Net = Brut - Amort
            cle_ctrl = f'{poste}_net=brut-amort'
            if cle_ctrl in incoherences:
                ctrl = incoherences[cle_ctrl]
                # Marquer la cellule Net en rouge
                cell = ws.cell(row=row, column=7)
                cell.font = RED_FONT
                cell.fill = RED_FILL
                cell.border = RED_BORDER
                cell.comment = Comment(
                    f"INCOHÉRENCE : Net ≠ Brut - Amort\n"
                    f"Net extrait : {ctrl['extrait']:,.2f}\n"
                    f"Net calculé (Brut-Amort) : {ctrl['calcule']:,.2f}\n"
                    f"Écart : {ctrl['ecart']:,.2f}",
                    "CONTRÔLE"
                )

        # Vérifier les totaux
        totaux_actif = [
            ('total_actif_non_courant', 21),
            ('total_actif_courant', 32),
            ('total_general_actif', 33),
        ]
        for poste, row in totaux_actif:
            for suf, col_net in [('n', 7), ('n1', 10)]:
                cle_ctrl = f'{poste}_{suf}'
                if cle_ctrl in incoherences:
                    ctrl = incoherences[cle_ctrl]
                    cell = ws.cell(row=row, column=col_net)
                    cell.font = RED_FONT
                    cell.fill = RED_FILL
                    cell.border = RED_BORDER
                    cell.comment = Comment(
                        f"INCOHÉRENCE : Total ≠ somme des postes\n"
                        f"Total extrait : {ctrl['extrait']:,.2f}\n"
                        f"Total calculé : {ctrl['calcule']:,.2f}\n"
                        f"Écart : {ctrl['ecart']:,.2f}",
                        "CONTRÔLE"
                    )

    # ─── REMPLIR LA FEUILLE PASSIF ───
    if 'Saisie passif' in wb.sheetnames:
        ws = wb['Saisie passif']

        for poste, row in FORFAIT_PASSIF_ROWS.items():
            net   = passif.get(f'{poste}_n')
            net_n1 = passif.get(f'{poste}_n1')

            if net is not None:
                ws.cell(row=row, column=3, value=to_kdzd(net))
            if net_n1 is not None:
                ws.cell(row=row, column=4, value=to_kdzd(net_n1))

        # Vérifier les totaux
        totaux_passif = [
            ('total_capitaux_propres', 13),
            ('total_passifs_non_courants', 19),
            ('total_passifs_courants', 25),
            ('total_general_passif', 26),
        ]
        for poste, row in totaux_passif:
            for suf, col in [('n', 3), ('n1', 4)]:
                cle_ctrl = f'{poste}_{suf}'
                if cle_ctrl in incoherences:
                    ctrl = incoherences[cle_ctrl]
                    cell = ws.cell(row=row, column=col)
                    cell.font = RED_FONT
                    cell.fill = RED_FILL
                    cell.border = RED_BORDER
                    cell.comment = Comment(
                        f"INCOHÉRENCE : Total ≠ somme des postes\n"
                        f"Total extrait : {ctrl['extrait']:,.2f}\n"
                        f"Total calculé : {ctrl['calcule']:,.2f}\n"
                        f"Écart : {ctrl['ecart']:,.2f}",
                        "CONTRÔLE"
                    )

    # ─── REMPLIR LA FEUILLE TCR ───
    if 'Saisie TCR' in wb.sheetnames:
        ws = wb['Saisie TCR']

        for poste, row in FORFAIT_TCR_ROWS.items():
            val_n  = tcr.get(f'{poste}_n')
            val_n1 = tcr.get(f'{poste}_n1')

            if val_n is not None:
                # Déterminer la colonne DEBIT ou CREDIT
                if poste in TCR_CREDIT:
                    col = 4  # CREDIT N
                elif poste in TCR_DEBIT:
                    col = 3  # DEBIT N
                else:
                    # Postes variables : selon le signe
                    col = 4 if val_n >= 0 else 3

                ws.cell(row=row, column=col, value=to_kdzd(abs(val_n)))

            if val_n1 is not None:
                if poste in TCR_CREDIT:
                    col = 6  # CREDIT N-1
                elif poste in TCR_DEBIT:
                    col = 5  # DEBIT N-1
                else:
                    col = 6 if val_n1 >= 0 else 5

                ws.cell(row=row, column=col, value=to_kdzd(abs(val_n1)))

        # Vérifier les sous-totaux TCR
        totaux_tcr = [
            ('chiffre_affaires_net', 10),
            ('production_exercice', 14),
            ('consommations_exercice', 32),
            ('valeur_ajoutee_exploitation', 33),
            ('excedent_brut_exploitation', 36),
            ('resultat_operationnel', 43),
            ('resultat_financier', 46),
            ('resultat_ordinaire', 47),
            ('resultat_net_exercice', 53),
        ]
        for poste, row in totaux_tcr:
            for suf, col_credit, col_debit in [('n', 4, 3), ('n1', 6, 5)]:
                cle_ctrl = f'{poste}_{suf}'
                if cle_ctrl in incoherences:
                    ctrl = incoherences[cle_ctrl]
                    # Marquer en rouge la colonne CREDIT (ou DEBIT selon le signe)
                    val = ctrl['extrait']
                    col = col_credit if (val or 0) >= 0 else col_debit
                    cell = ws.cell(row=row, column=col)
                    cell.font = RED_FONT
                    cell.fill = RED_FILL
                    cell.border = RED_BORDER
                    cell.comment = Comment(
                        f"INCOHÉRENCE : Sous-total ≠ calcul\n"
                        f"Valeur extraite : {ctrl['extrait']:,.2f}\n"
                        f"Valeur calculée : {ctrl['calcule']:,.2f}\n"
                        f"Écart : {ctrl['ecart']:,.2f}",
                        "CONTRÔLE"
                    )

    # ─── SAUVEGARDER ───
    wb.save(chemin_sortie)

    # ─── RAPPORT DE CONTRÔLE ───
    rapport = {
        'fichier_json': json_path.name,
        'fichier_forfait': nom_fichier,
        'entreprise': entreprise,
        'exercice': exercice,
        'nombre_controles': len(tous_controles),
        'nombre_conformes': len(tous_controles) - len(incoherences),
        'nombre_incoherences': len(incoherences),
        'incoherences': {k: v for k, v in incoherences.items()},
    }

    return rapport


# ════════════════════════════════════════════════════════════════════
# PARTIE 3 : EXÉCUTION
# ════════════════════════════════════════════════════════════════════

def executer_controles():
    """
    Exécute les contrôles sur tous les JSON et génère les fichiers FORFAIT.
    """
    json_files = sorted(JSON_DIR.glob('*.json'))

    if not json_files:
        print("⚠️ Aucun fichier JSON trouvé dans", JSON_DIR)
        return

    print(f"📁 {len(json_files)} fichiers JSON trouvés")
    print("=" * 70)

    rapports = []

    for json_path in json_files:
        print(f"\n🔍 Traitement : {json_path.name}")
        print("-" * 50)

        try:
            rapport = generer_forfait(json_path)
            rapports.append(rapport)

            print(f"  Entreprise : {rapport['entreprise']}")
            print(f"  Exercice   : {rapport['exercice']}")
            print(f"  Fichier    : {rapport['fichier_forfait']}")
            print(f"  Contrôles  : {rapport['nombre_controles']}")
            print(f"  Conformes  : {rapport['nombre_conformes']}")
            print(f"  Incohérents: {rapport['nombre_incoherences']}")

            if rapport['incoherences']:
                print(f"\n  ⚠️ INCOHÉRENCES DÉTECTÉES :")
                for cle, ctrl in rapport['incoherences'].items():
                    print(f"    ❌ {cle}")
                    print(f"       Extrait : {ctrl['extrait']:,.2f}")
                    print(f"       Calculé : {ctrl['calcule']:,.2f}")
                    print(f"       Écart   : {ctrl['ecart']:,.2f}")
            else:
                print("  ✅ Tous les contrôles sont conformes")

        except Exception as e:
            print(f"  ❌ Erreur : {e}")
            import traceback
            traceback.print_exc()

    # ─── RÉSUMÉ FINAL ───
    print("\n" + "=" * 70)
    print("📊 RÉSUMÉ FINAL")
    print("=" * 70)

    total_controles = sum(r['nombre_controles'] for r in rapports)
    total_conformes = sum(r['nombre_conformes'] for r in rapports)
    total_incoherences = sum(r['nombre_incoherences'] for r in rapports)

    print(f"Fichiers traités  : {len(rapports)}")
    print(f"Contrôles totaux  : {total_controles}")
    print(f"Conformes         : {total_conformes}")
    print(f"Incohérences      : {total_incoherences}")
    print(f"Taux de conformité: {total_conformes/total_controles*100:.1f}%" if total_controles > 0 else "")

    if total_incoherences > 0:
        print(f"\n⚠️ {total_incoherences} incohérence(s) détectée(s)")
        print("Les cellules incohérentes sont marquées en ROUGE dans les fichiers FORFAIT")
    else:
        print("\n✅ Tous les contrôles sont conformes")

    return rapports


# ─── LANCER L'EXÉCUTION ───
if __name__ == '__main__':
    rapports = executer_controles()
