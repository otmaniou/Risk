def controle_actif(actif: dict) -> dict:
    """
    Contrôle tous les postes de l'actif.
    Retourne un dict {poste: {'calcule': X, 'extrait': Y, 'ok': bool, 'ecart': Z}}
    """
    resultats = {}

    # ─── Contrôle 1 : Net = Brut - Amort pour CHAQUE poste ───
    postes_detail = [
        'ecarts_acquisition_goodwill',
        'immobilisations_incorporelles',
        'terrains',
        'batiments',
        'autres_immobilisations_corporelles',
        'immobilisations_en_concession',
        'immobilisations_en_cours',
        'titres_mis_en_equivalence',
        'autres_participations_creances',
        'autres_titres_immobilises',
        'prets_actifs_financiers_non_courants',
        'impots_differes_actif',
        'stocks_encours',
        'clients',
        'autres_debiteurs',
        'impots_assimiles_actif',
        'autres_creances_assimiles',
        'placements_financiers_courants',
        'tresorerie_actif',
    ]

    for poste in postes_detail:
        brut  = actif.get(f'{poste}_brut')
        amort = actif.get(f'{poste}_amort')
        net   = actif.get(f'{poste}_n')

        if brut is not None and net is not None:
            amort_val = amort if amort is not None else 0.0
            calcule = brut - amort_val
            ecart = abs(calcule - net)
            resultats[f'{poste}_net=brut-amort'] = {
                'calcule': calcule,
                'extrait': net,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    # ─── Contrôle 2 : TOTAL ACTIF NON COURANT = somme des postes ───
    postes_non_courants = [
        'ecarts_acquisition_goodwill',
        'immobilisations_incorporelles',
        'terrains',
        'batiments',
        'autres_immobilisations_corporelles',
        'immobilisations_en_concession',
        'immobilisations_en_cours',
        'titres_mis_en_equivalence',
        'autres_participations_creances',
        'autres_titres_immobilises',
        'prets_actifs_financiers_non_courants',
        'impots_differes_actif',
    ]

    for suf, label in [('n', 'N'), ('n1', 'N-1')]:
        somme = 0.0
        a_des_valeurs = False
        for poste in postes_non_courants:
            val = actif.get(f'{poste}_{suf}')
            if val is not None:
                somme += val
                a_des_valeurs = True

        total_extrait = actif.get(f'total_actif_non_courant_{suf}')
        if a_des_valeurs and total_extrait is not None:
            ecart = abs(somme - total_extrait)
            resultats[f'total_actif_non_courant_{suf}'] = {
                'calcule': somme,
                'extrait': total_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    # ─── Contrôle 3 : TOTAL ACTIF COURANT = somme des postes ───
    postes_courants = [
        'stocks_encours',
        'clients',
        'autres_debiteurs',
        'impots_assimiles_actif',
        'autres_creances_assimiles',
        'placements_financiers_courants',
        'tresorerie_actif',
    ]

    for suf, label in [('n', 'N'), ('n1', 'N-1')]:
        somme = 0.0
        a_des_valeurs = False
        for poste in postes_courants:
            val = actif.get(f'{poste}_{suf}')
            if val is not None:
                somme += val
                a_des_valeurs = True

        total_extrait = actif.get(f'total_actif_courant_{suf}')
        if a_des_valeurs and total_extrait is not None:
            ecart = abs(somme - total_extrait)
            resultats[f'total_actif_courant_{suf}'] = {
                'calcule': somme,
                'extrait': total_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    # ─── Contrôle 4 : TOTAL GENERAL ACTIF = NON COURANT + COURANT ───
    for suf, label in [('n', 'N'), ('n1', 'N-1')]:
        tnc = actif.get(f'total_actif_non_courant_{suf}')
        tc  = actif.get(f'total_actif_courant_{suf}')
        tg  = actif.get(f'total_general_actif_{suf}')

        if tnc is not None and tc is not None and tg is not None:
            calcule = tnc + tc
            ecart = abs(calcule - tg)
            resultats[f'total_general_actif_{suf}'] = {
                'calcule': calcule,
                'extrait': tg,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    return resultats


def controle_passif(passif: dict) -> dict:
    """
    Contrôle tous les postes du passif.
    """
    resultats = {}

    # ─── Contrôle 1 : TOTAL I = somme des capitaux propres ───
    postes_fp = [
        'capital_emis',
        'capital_non_appele',
        'primes_reserves',
        'ecart_reevaluation',
        'ecart_equivalence',
        'resultat_net_passif',
        'report_a_nouveau',
        'part_societe_consolidante',
        'part_minoritaires',
    ]

    for suf in ['n', 'n1']:
        somme = 0.0
        a_des_valeurs = False
        for poste in postes_fp:
            val = passif.get(f'{poste}_{suf}')
            if val is not None:
                somme += val
                a_des_valeurs = True

        total_extrait = passif.get(f'total_capitaux_propres_{suf}')
        if a_des_valeurs and total_extrait is not None:
            ecart = abs(somme - total_extrait)
            resultats[f'total_capitaux_propres_{suf}'] = {
                'calcule': somme,
                'extrait': total_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    # ─── Contrôle 2 : TOTAL II = somme des passifs non courants ───
    postes_nc = [
        'emprunts_dettes_financieres',
        'impots_differes_provisionnes',
        'autres_dettes_non_courantes',
        'provisions_produits_avance',
    ]

    for suf in ['n', 'n1']:
        somme = 0.0
        a_des_valeurs = False
        for poste in postes_nc:
            val = passif.get(f'{poste}_{suf}')
            if val is not None:
                somme += val
                a_des_valeurs = True

        total_extrait = passif.get(f'total_passifs_non_courants_{suf}')
        if a_des_valeurs and total_extrait is not None:
            ecart = abs(somme - total_extrait)
            resultats[f'total_passifs_non_courants_{suf}'] = {
                'calcule': somme,
                'extrait': total_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    # ─── Contrôle 3 : TOTAL III = somme des passifs courants ───
    postes_c = [
        'fournisseurs_rattaches',
        'impots_passif',
        'autres_dettes',
        'tresorerie_passif',
    ]

    for suf in ['n', 'n1']:
        somme = 0.0
        a_des_valeurs = False
        for poste in postes_c:
            val = passif.get(f'{poste}_{suf}')
            if val is not None:
                somme += val
                a_des_valeurs = True

        total_extrait = passif.get(f'total_passifs_courants_{suf}')
        if a_des_valeurs and total_extrait is not None:
            ecart = abs(somme - total_extrait)
            resultats[f'total_passifs_courants_{suf}'] = {
                'calcule': somme,
                'extrait': total_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    # ─── Contrôle 4 : TOTAL GENERAL PASSIF = I + II + III ───
    for suf in ['n', 'n1']:
        t1 = passif.get(f'total_capitaux_propres_{suf}')
        t2 = passif.get(f'total_passifs_non_courants_{suf}')
        t3 = passif.get(f'total_passifs_courants_{suf}')
        tg = passif.get(f'total_general_passif_{suf}')

        if t1 is not None and t2 is not None and t3 is not None and tg is not None:
            calcule = t1 + t2 + t3
            ecart = abs(calcule - tg)
            resultats[f'total_general_passif_{suf}'] = {
                'calcule': calcule,
                'extrait': tg,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    return resultats


def controle_tcr(tcr: dict) -> dict:
    """
    Contrôle les sous-totaux du TCR.
    """
    resultats = {}

    for suf in ['n', 'n1']:
        # ─── CA NET = somme des ventes - rabais ───
        ventes = [
            'ventes_marchandises',
            'produits_fabriques',
            'prestations_services',
            'ventes_travaux',
            'produits_annexes',
        ]
        somme_ventes = sum(tcr.get(f'{v}_{suf}') or 0 for v in ventes)
        rabais = tcr.get(f'rabais_remises_ristournes_accordes_{suf}') or 0
        ca_calcule = somme_ventes - rabais
        ca_extrait = tcr.get(f'chiffre_affaires_net_{suf}')

        if ca_extrait is not None and (somme_ventes > 0 or rabais > 0):
            ecart = abs(ca_calcule - ca_extrait)
            resultats[f'chiffre_affaires_net_{suf}'] = {
                'calcule': ca_calcule,
                'extrait': ca_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── I-PRODUCTION = CA + production stockée + production immobilisée + subventions ───
        prod_stockee = tcr.get(f'production_stockee_destockee_{suf}') or 0
        prod_immo = tcr.get(f'production_immobilisee_{suf}') or 0
        subventions = tcr.get(f'subvention_exploitation_{suf}') or 0
        prod_calcule = (ca_extrait or 0) + prod_stockee + prod_immo + subventions
        prod_extrait = tcr.get(f'production_exercice_{suf}')

        if prod_extrait is not None and (ca_extrait or prod_stockee or prod_immo or subventions):
            ecart = abs(prod_calcule - prod_extrait)
            resultats[f'production_exercice_{suf}'] = {
                'calcule': prod_calcule,
                'extrait': prod_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── II-CONSOMMATIONS = somme des achats et charges externes ───
        consommations = [
            'achats_marchandises_vendues',
            'matieres_premieres',
            'autres_approvisionnements',
            'variation_stocks',
            'achats_etudes_prestations',
            'autres_consommations',
            'sous_traitance_generale',
            'locations',
            'entretien_reparations',
            'primes_assurances',
            'personnel_exterieur',
            'remuneration_intermediaires',
            'publicite',
            'deplacements_missions',
            'autres_services',
        ]
        somme_conso = sum(tcr.get(f'{c}_{suf}') or 0 for c in consommations)
        rabais_achats = tcr.get(f'rabais_remises_obtenus_achats_{suf}') or 0
        rabais_services = tcr.get(f'rabais_remises_obtenus_services_{suf}') or 0
        conso_calcule = somme_conso - rabais_achats - rabais_services
        conso_extrait = tcr.get(f'consommations_exercice_{suf}')

        if conso_extrait is not None and somme_conso > 0:
            ecart = abs(conso_calcule - conso_extrait)
            resultats[f'consommations_exercice_{suf}'] = {
                'calcule': conso_calcule,
                'extrait': conso_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── III-VA = I - II ───
        va_calcule = (prod_extrait or 0) - (conso_extrait or 0)
        va_extrait = tcr.get(f'valeur_ajoutee_exploitation_{suf}')

        if va_extrait is not None and (prod_extrait or conso_extrait):
            ecart = abs(va_calcule - va_extrait)
            resultats[f'valeur_ajoutee_exploitation_{suf}'] = {
                'calcule': va_calcule,
                'extrait': va_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── IV-EBE = III - charges personnel - impôts taxes ───
        charges_pers = tcr.get(f'charges_personnel_{suf}') or 0
        impots_taxes = tcr.get(f'impots_taxes_assimiles_{suf}') or 0
        ebe_calcule = (va_extrait or 0) - charges_pers - impots_taxes
        ebe_extrait = tcr.get(f'excedent_brut_exploitation_{suf}')

        if ebe_extrait is not None and (va_extrait or charges_pers or impots_taxes):
            ecart = abs(ebe_calcule - ebe_extrait)
            resultats[f'excedent_brut_exploitation_{suf}'] = {
                'calcule': ebe_calcule,
                'extrait': ebe_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── V-Résultat opérationnel = IV + autres produits - autres charges - dotations - provisions - pertes + reprises ───
        autres_prod = tcr.get(f'autres_produits_operationnels_{suf}') or 0
        autres_charges = tcr.get(f'autres_charges_operationnelles_{suf}') or 0
        dotations = tcr.get(f'dotations_amortissements_{suf}') or 0
        provisions = tcr.get(f'provisions_{suf}') or 0
        pertes = tcr.get(f'pertes_valeur_{suf}') or 0
        reprises = tcr.get(f'reprises_pertes_valeur_provisions_{suf}') or 0

        res_op_calcule = (ebe_extrait or 0) + autres_prod - autres_charges - dotations - provisions - pertes + reprises
        res_op_extrait = tcr.get(f'resultat_operationnel_{suf}')

        if res_op_extrait is not None and (ebe_extrait or autres_prod or autres_charges):
            ecart = abs(res_op_calcule - res_op_extrait)
            resultats[f'resultat_operationnel_{suf}'] = {
                'calcule': res_op_calcule,
                'extrait': res_op_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── VI-Résultat financier = produits financiers - charges financières ───
        prod_fin = tcr.get(f'produits_financiers_{suf}') or 0
        charges_fin = tcr.get(f'charges_financieres_{suf}') or 0
        res_fin_calcule = prod_fin - charges_fin
        res_fin_extrait = tcr.get(f'resultat_financier_{suf}')

        if res_fin_extrait is not None and (prod_fin or charges_fin):
            ecart = abs(res_fin_calcule - res_fin_extrait)
            resultats[f'resultat_financier_{suf}'] = {
                'calcule': res_fin_calcule,
                'extrait': res_fin_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── VII-Résultat ordinaire = V + VI ───
        res_ord_calcule = (res_op_extrait or 0) + (res_fin_extrait or 0)
        res_ord_extrait = tcr.get(f'resultat_ordinaire_{suf}')

        if res_ord_extrait is not None and (res_op_extrait or res_fin_extrait):
            ecart = abs(res_ord_calcule - res_ord_extrait)
            resultats[f'resultat_ordinaire_{suf}'] = {
                'calcule': res_ord_calcule,
                'extrait': res_ord_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

        # ─── IX-Résultat net = VII + VIII - impôts ───
        res_extra = tcr.get(f'resultat_extraordinaire_{suf}') or 0
        impots_exig = tcr.get(f'impots_exigibles_resultats_{suf}') or 0
        impots_diff = tcr.get(f'impots_differes_resultats_{suf}') or 0
        res_net_calcule = (res_ord_extrait or 0) + res_extra - impots_exig - impots_diff
        res_net_extrait = tcr.get(f'resultat_net_exercice_{suf}')

        if res_net_extrait is not None and (res_ord_extrait or impots_exig):
            ecart = abs(res_net_calcule - res_net_extrait)
            resultats[f'resultat_net_exercice_{suf}'] = {
                'calcule': res_net_calcule,
                'extrait': res_net_extrait,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    return resultats


def controle_croise(actif: dict, passif: dict, tcr: dict) -> dict:
    """
    Contrôles croisés entre actif, passif et TCR.
    """
    resultats = {}

    # Actif = Passif
    for suf in ['n', 'n1']:
        ta = actif.get(f'total_general_actif_{suf}')
        tp = passif.get(f'total_general_passif_{suf}')
        if ta is not None and tp is not None:
            ecart = abs(ta - tp)
            resultats[f'actif=passif_{suf}'] = {
                'calcule': ta,
                'extrait': tp,
                'ok': ecart <= TOLERANCE_DA,
                'ecart': ecart
            }

    # RN TCR = RN Passif
    rn_tcr = tcr.get('resultat_net_exercice_n')
    rn_passif = passif.get('resultat_net_passif_n')
    if rn_tcr is not None and rn_passif is not None:
        ecart = abs(rn_tcr - rn_passif)
        resultats['rn_tcr=rn_passif'] = {
            'calcule': rn_tcr,
            'extrait': rn_passif,
            'ok': ecart <= TOLERANCE_DA,
            'ecart': ecart
        }

    return resultats


