def generate_forfait_v4(result):
    """
    Génère un fichier FORFAIT à partir des données extraites.
    Utilise des coordonnées fixes basées sur l'analyse du template.
    """
    if not TEMPLATE_FORFAIT.exists():
        print(f"❌ Template introuvable : {TEMPLATE_FORFAIT}")
        return None
    
    if TEMPLATE_FORFAIT.suffix != '.xlsx':
        print(f"❌ Le template doit être en .xlsx : {TEMPLATE_FORFAIT}")
        return None
    
    entreprise = _clean_name(result.get('entreprise'))
    annee = result.get('exercice') or 'XXXX'
    out_path = FORFAIT_OUTPUT_DIR / f'FORFAIT Cas 1_{entreprise}_{annee}.xlsx'
    
    try:
        # Copier le template
        shutil.copy2(TEMPLATE_FORFAIT, out_path)
        
        # Ouvrir avec openpyxl
        wb = load_workbook(out_path)
        
        actif = result.get('ACTIF') or {}
        passif = result.get('PASSIF') or {}
        tcr = result.get('TCR') or {}
        decl = result.get('DECL') or {}
        
        n_filled = 0
        
        # ── Saisie actif ────────────────────────────────────
        if 'Saisie actif' in wb.sheetnames:
            ws = wb['Saisie actif']
            
            # En-tête
            r, c = FORFAIT_ACTIF_HEADER['nature_bilan']
            ws.cell(row=r, column=c, value='Fiscal')
            
            exerc = result.get('exercice')
            if exerc:
                r, c = FORFAIT_ACTIF_HEADER['date_arrete_n']
                ws.cell(row=r, column=c, value=exerc)
                
                m = re.match(r'(\d{2})/(\d{2})/(\d{4})', exerc)
                if m:
                    n1 = f"{m.group(1)}/{m.group(2)}/{int(m.group(3)) - 1}"
                    r, c = FORFAIT_ACTIF_HEADER['date_arrete_n1']
                    ws.cell(row=r, column=c, value=n1)
            
            cac = decl.get('cac_cabinet') or decl.get('cac_nom')
            if cac:
                r, c = FORFAIT_ACTIF_HEADER['certifie_cac']
                ws.cell(row=r, column=c, value=cac)
            
            # Postes
            for key, coords in FORFAIT_ACTIF_COORDS.items():
                row, col_brut, col_amort, col_net, col_net_n1 = coords
                
                v_brut = to_kdzd(actif.get(f'{key}_brut'))
                v_amort = to_kdzd(actif.get(f'{key}_amort'))
                v_net = to_kdzd(actif.get(f'{key}_n'))
                v_net_n1 = to_kdzd(actif.get(f'{key}_n1'))
                
                if v_brut is not None:
                    ws.cell(row=row, column=col_brut, value=v_brut)
                    n_filled += 1
                if v_amort is not None:
                    ws.cell(row=row, column=col_amort, value=v_amort)
                    n_filled += 1
                if v_net is not None:
                    ws.cell(row=row, column=col_net, value=v_net)
                    n_filled += 1
                if v_net_n1 is not None:
                    ws.cell(row=row, column=col_net_n1, value=v_net_n1)
                    n_filled += 1
        
        # ── Saisie passif ───────────────────────────────────
        if 'Saisie passif' in wb.sheetnames:
            ws = wb['Saisie passif']
            
            for key, coords in FORFAIT_PASSIF_COORDS.items():
                row, col_n, col_n1 = coords
                
                v_n = to_kdzd(passif.get(f'{key}_n'))
                v_n1 = to_kdzd(passif.get(f'{key}_n1'))
                
                if v_n is not None:
                    ws.cell(row=row, column=col_n, value=v_n)
                    n_filled += 1
                if v_n1 is not None:
                    ws.cell(row=row, column=col_n1, value=v_n1)
                    n_filled += 1
        
        # ── Saisie TCR ──────────────────────────────────────
        if 'Saisie TCR' in wb.sheetnames:
            ws = wb['Saisie TCR']
            
            for key, coords in FORFAIT_TCR_COORDS.items():
                row, col_deb_n, col_cred_n, col_deb_n1, col_cred_n1 = coords
                
                v_deb_n = to_kdzd(tcr.get(f'{key}_debit_n'))
                v_cred_n = to_kdzd(tcr.get(f'{key}_credit_n'))
                v_deb_n1 = to_kdzd(tcr.get(f'{key}_debit_n1'))
                v_cred_n1 = to_kdzd(tcr.get(f'{key}_credit_n1'))
                
                if v_deb_n is not None:
                    ws.cell(row=row, column=col_deb_n, value=v_deb_n)
                    n_filled += 1
                if v_cred_n is not None:
                    ws.cell(row=row, column=col_cred_n, value=v_cred_n)
                    n_filled += 1
                if v_deb_n1 is not None:
                    ws.cell(row=row, column=col_deb_n1, value=v_deb_n1)
                    n_filled += 1
                if v_cred_n1 is not None:
                    ws.cell(row=row, column=col_cred_n1, value=v_cred_n1)
                    n_filled += 1
        
        # Sauvegarder
        wb.save(out_path)
        wb.close()
        
        print(f"✅ FORFAIT : {out_path.name} | {n_filled} cellules remplies")
        return out_path
        
    except Exception as e:
        print(f"❌ Erreur génération FORFAIT : {e}")
        import traceback
        traceback.print_exc()
        return None


print("✅ Générateur FORFAIT V4 (coordonnées fixes) défini")
