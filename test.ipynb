# ─── Exécution ──────────────────────────────────────────────
json_files = sorted(JSON_DIR.glob('*.json'))
if not json_files:
    print('⚠️ Aucun JSON trouvé')
else:
    print(f"📁 {len(json_files)} JSON → génération FORFAIT")
    n_gen = n_err = 0
    for jf in json_files:
        try:
            data = json.load(open(jf, encoding='utf-8'))
            if not (data.get('ACTIF') or data.get('PASSIF') or data.get('TCR')):
                print(f"⏭️  {jf.stem} : aucune donnée → ignoré")
                continue
            if generate_forfait(data):
                n_gen += 1
        except Exception as e:
            print(f"❌ {jf.stem} : {e}")
            n_err += 1
    print(f"\n✅ {n_gen} FORFAIT générés | {n_err} erreurs → {FORFAIT_OUTPUT_DIR}")
