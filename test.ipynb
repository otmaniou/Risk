# ════════════════════════════════════════════════════════════
# GÉNÉRATEUR FORFAIT CORRIGÉ — V5
# - Recherche par libellé (pas de coordonnées fixes)
# - TCR : ventilation DEBIT/CREDIT depuis _n/_n1
# - Conversion dinars → KDZD (÷1000)
# ════════════════════════════════════════════════════════════
import shutil
from openpyxl import load_workbook
from pathlib import Path
import json, re

TEMPLATE_FORFAIT   = Path('/mnt/data/forfait/FORFAIT Cas 1 TARZAALI.xlsx')  # ← AJUSTER
JSON_DIR           = Path('/mnt/data/bilans_out/json_bilans')               # ← AJUSTER
FORFAIT_OUTPUT_DIR = Path('/mnt/data/bilans_out/forfaits')                  # ← AJUSTER
FORFAIT_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


# ─── Fonctions utilitaires ──────────────────────────────────
def to_kdzd(v):
    """Dinars → KDZD. None si absent."""
    if v is None:
        return None
    return round(v / 1000.0, 2)

def _clean(s):
    """Nettoie un nom pour le nom de fichier."""
    return re.sub(r'[^A-Za-z0-9 _-]', '', s or 'ENTREPRISE').strip()

def _norm_label(s):
    """Normalise un libellé pour la recherche."""
    if s is None:
        return ''
    s = str(s).lower()
    s = re.sub(r'[^a-z0-9]', '', s)
    return s

def find_row_by_label(ws, patterns, label_cols=(1, 2, 3), max_row=80):
    """
    Cherche une ligne dans le worksheet par libellé.
    Retourne le numéro de ligne ou None.
    """
    for row in range(1, min(ws.max_row + 1, max_row)):
        for col in label_cols:
            v = ws.cell(row=row, column=col).value
            if v is None:
                continue
            v_norm = _norm_label(v)
            for pat in patterns:
                if _norm_label(pat) in v_norm:
                    return row
    return None

def safe_write(ws, row, col, value):
    """Écrit une valeur si row/col sont valides et value n'est pas None."""
    if row is None or value is None:
        return False
    ws.cell(row=row, column=col, value=value)
    return True


# ─── Table de sens TCR (DEBIT ou CREDIT) ───────────────────
# Postes qui vont au CREDIT (produits)
TCR_CREDIT = {
    'ventes_marchandises', 'produits_fabriques', 'prestations_services',
    'ventes_travaux', 'produits_annexes', 'chiffre_affaires_net',
    'production_stockee_destockee', 'production_immobilisee',
    'subvention_exploitation', 'production_exercice',
    'rabais_remises_obtenus_achats', 'rabais_remises_obtenus_services',
    'valeur_ajoutee_exploitation', 'excedent_brut_exploitation',
    'autres_produits_operationnels', 'reprises_pertes_valeur_provisions',
    'produits_financiers', 'elements_extraordinaires_produits',
}

# Postes qui vont au DEBIT (charges)
TCR_DEBIT = {
    'rabais_remises_ristournes_accordes', 'achats_marchandises_vendues',
    'matieres_premieres', 'autres_approvisionnements', 'variation_stocks',
    'achats_etudes_prestations', 'autres_consommations',
    'sous_traitance_generale', 'locations', 'entretien_reparations',
    'primes_assurances', 'personnel_exterieur', 'remuneration_intermediaires',
    'publicite', 'deplacements_missions', 'autres_services',
    'consommations_exercice', 'charges_personnel', 'impots_taxes_assimiles',
    'autres_charges_operationnelles', 'dotations_amortissements',
    'provisions', 'pertes_valeur', 'charges_financieres',
    'elements_extraordinaires_charges', 'impots_exigibles_resultats',
    'impots_differes_resultats',
}

# Postes dont le sens dépend du signe de la valeur
TCR_VARIABLE = {
    'resultat_operationnel', 'resultat_financier', 'resultat_ordinaire',
    'resultat_extraordinaire', 'resultat_net_exercice',
}


def write_tcr_row(ws, row, col_deb_n, col_cred_n, col_deb_n1, col_cred_n1,
                  key, tcr):
    """
    Écrit une ligne TCR en ventilant DEBIT/CREDIT.
    tcr : dict du JSON avec clés {poste}_n, {poste}_n1.
    """
    n_filled = 0
    
    for suffix, col_d, col_c in [
        ('n',   col_deb_n,  col_cred_n),
        ('n1',  col_deb_n1, col_cred_n1),
    ]:
        val = tcr.get(f'{key}_{suffix}')
        if val is None:
            continue
        
        if key in TCR_CREDIT:
            # Produit → CREDIT
            if val >= 0:
                n_filled += safe_write(ws, row, col_c, round(abs(val), 2))
            else:
                n_filled += safe_write(ws, row, col_d, round(abs(val), 2))
        elif key in TCR_DEBIT:
            # Charge → DEBIT
            if val >= 0:
                n_filled += safe_write(ws, row, col_d, round(abs(val), 2))
            else:
                n_filled += safe_write(ws, row, col_c, round(abs(val), 2))
        elif key in TCR_VARIABLE:
            # Résultat → sens selon le signe
            if val >= 0:
                n_filled += safe_write(ws, row, col_c, round(abs(val), 2))
            else:
                n_filled += safe_write(ws, row, col_d, round(abs(val), 2))
    
    return n_filled


# ─── Générateur principal ───────────────────────────────────
